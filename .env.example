# Modelo de variáveis de ambiente. NUNCA coloque valores reais aqui.
# Local: `pnpm env:local` (ou `pnpm db:up`) gera `.env` a partir deste modelo com
# valores locais e um PAYLOAD_SECRET aleatório. `.env` não é versionado.
# Preview, homologação e produção: valores definidos nos GitHub Environments
# (`preview`, `staging`, `production`) e repassados à Vercel pelo pipeline.

# local | preview | staging | production  (ausente => tratado como local, com noindex)
APP_ENV=

# PostgreSQL. Local: Postgres do docker-compose. Nunca aponte para bancos Neon localmente.
DATABASE_URL=
# Banco usado pelos testes de integração e E2E (local: ppgps_test no mesmo container)
DATABASE_URL_TEST=

# Segredo do Payload. Distinto em cada ambiente (gerar com `openssl rand -hex 32`).
PAYLOAD_SECRET=

# URL pública do ambiente, usada nos links dos e-mails (nunca derivada do cabeçalho Host).
# Local: http://localhost:3000. Preview: VERCEL_URL (automático). Homologação: domínio fixo.
SERVER_URL=

# Autenticação básica. Obrigatória em preview/staging (sem ela: 503). Opcional no local.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Conta administrativa FICTÍCIA criada por `pnpm seed` (somente local, seed e preview)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Armazenamento S3 compatível (ADR-0011). Local: MinIO. Preview/homologação: Cloudflare R2.
# Somente servidor: nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Bucket do MinIO usado pelos testes automatizados (local/CI)
S3_BUCKET_TEST=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para MinIO/R2 (endereçamento por caminho)
S3_FORCE_PATH_STYLE=
# Prefixo raiz do ambiente (preview: pr-N). Vazio no local e na homologação.
S3_PREFIX=

# E-mail (SMTP). Local: Mailpit (captura). Sem SMTP fora da produção, as mensagens são
# descartadas (só metadados mascarados no log). Fora da produção, SMTP remoto só se for
# caixa de testes declarada com EMAIL_SMTP_IS_SANDBOX=true.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
EMAIL_SMTP_IS_SANDBOX=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# API do Mailpit usada pelos testes (local/CI)
MAILPIT_API_URL=

# Sentry (opcional; sem DSN o app funciona normalmente). DSN não é segredo.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Endpoint de relatórios de CSP (opcional; ex.: endpoint "security" do Sentry)
CSP_REPORT_URI=

# Docker Compose local (Postgres, MinIO e Mailpit).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=
