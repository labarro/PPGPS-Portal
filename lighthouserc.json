{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/o-grupo",
        "http://localhost:3100/o-grupo/historico",
        "http://localhost:3100/linhas",
        "http://localhost:3100/linhas/bioetica",
        "http://localhost:3100/integrantes",
        "http://localhost:3100/integrantes/marina-ficticia-duarte",
        "http://localhost:3100/blog",
        "http://localhost:3100/blog/ensaio-ficticio-autonomia-e-cuidado"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 300000 }],
            "resource-summary:total:size": ["warn", { "maxNumericValue": 600000 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }]
          }
        },
        {
          "matchingUrlPattern": ".*/blog/ensaio-ficticio-autonomia-e-cuidado$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["error", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
